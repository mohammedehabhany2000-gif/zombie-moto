[sub_resource type="GDScript" id="GDScript_vk1bi"]
script/source = "extends Node2D


const bullet = preload(\"res://scenes/bullet.tscn\")
@onready var shooting_sound= $AudioStreamPlayer2D
var target_rotation =0

func _process(delta: float) -> void:
	var mouse_position= get_global_mouse_position()
	var distance_to_mouse =global_position.distance_to(mouse_position)
	if distance_to_mouse>15:
		var angle_to_mouse=get_angle_to(mouse_position)
		var min_angle= deg_to_rad(-45)
		var max_angle= deg_to_rad(45)
		target_rotation = clamp(angle_to_mouse,min_angle,max_angle)
	rotation= lerp_angle(rotation,target_rotation,0.2)
	if Input.is_action_just_pressed(\"shoot\"):
		shoot()
	
func shoot()-> void:
	var new_bullet =bullet.instantiate()
	
	
	new_bullet.global_position= $Marker2D.global_position
	new_bullet.rotation = rotation
	new_bullet.direction = Vector2.RIGHT.rotated(rotation)
	get_tree().root.add_child(new_bullet)
	if has_node(\"AudioStreamPlayer2D\"):
		shooting_sound.play()
"

